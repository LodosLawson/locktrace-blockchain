[Unit]
Description=LockTrace Blockchain Mainnet Node
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/blockchaint
EnvironmentFile=-/opt/blockchaint/.env
Environment="PATH=/opt/blockchaint/venv/bin:/usr/bin"
Environment="BCT_LOG_LEVEL=INFO"
ExecStart=/opt/blockchaint/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 1 \
    --threads 8 \
    --timeout 60 \
    --access-logfile /opt/blockchaint/logs/access.log \
    --error-logfile /opt/blockchaint/logs/error.log \
    --log-level info \
    wsgi:app
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
