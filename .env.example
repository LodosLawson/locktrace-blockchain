# LockTrace Network Configuration Example
# Copy this file to .env and configure secrets securely.
# NEVER commit .env to version control!

# Server & Node Configuration
PORT=5000
HOST=0.0.0.0
BCT_NETWORK=mainnet

# Dedicated Bridge Relayer Configuration (Bridge Operators Only)
# DO NOT configure on standard validator or miner nodes!
# Relayer private key must be 64-hex characters without 0x prefix (or with 0x prefix).
BCT_RELAYER_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
WBCT_CONTRACT_ADDRESS=0xA3C743113a41cFd0146917065d4578337Bb77254
BCT_DB_PATH=data/blockchain.db

# Minimum EVM Confirmations before processing bridge burns/mints
MIN_EVM_CONFIRMATIONS=12

# Thirdweb Integration (Optional for Web3 Auth/Engine)
THIRDWEB_SECRET_KEY=
THIRDWEB_CLIENT_ID=
THIRDWEB_SERVER_WALLET_ADDRESS=

